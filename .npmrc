# Do not run dependency install scripts.
#
# Two reasons, in order of importance:
#
# 1. It is what makes `npm install` work here at all. `sharp` (pulled in by
#    @huggingface/transformers for Node-side image decoding) runs an install
#    script that checks for its prebuilt binary. npm sometimes runs that script
#    before it has linked the optional @img/sharp-<platform> package, so the
#    check fails, sharp falls back to a source build via node-gyp, and the whole
#    install aborts. Skipping scripts lets the prebuilt land normally — sharp
#    then works fine.
#
# 2. This is a browser-only app. Nothing it ships needs a native postinstall
#    step (esbuild and rollup resolve their binaries through optional platform
#    packages, not scripts), so not executing arbitrary install-time code from
#    the dependency tree costs nothing and removes a supply-chain foothold.
ignore-scripts=true
