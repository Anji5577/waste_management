# --- Gemini (required) -------------------------------------------------------
# Key from https://aistudio.google.com/apikey
#
# SECURITY: Vite inlines every VITE_-prefixed variable into the JavaScript
# bundle at build time. Every key below is therefore visible to anyone who loads
# the site — none of them are secrets. Acceptable for local and private use,
# which is what this build is configured for. Do NOT deploy publicly with keys
# you care about; see README → Security.
VITE_GEMINI_API_KEY=your-api-key-here

# --- Report storage (optional) ----------------------------------------------
# Leave any of these blank to disable saving. The app still analyses photos.

# ImgBB, from https://api.imgbb.com/  — NOTE: uploaded images are PUBLIC.
VITE_IMGBB_API_KEY=

# Supabase project URL and publishable (anon) key.
# Run supabase/001_reports.sql in the SQL editor before first use.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
