# ---------------------------------------------------------------------------
# SERVER-SIDE keys. No VITE_ prefix, so Vite never inlines them into the bundle
# and the browser never sees them. The /api/* proxy attaches them.
#
# On Vercel: add these as environment variables. "Secret" vs "Config" only
# controls who can read them back in the dashboard — either is fine, because
# unlike a VITE_ variable these genuinely stay on the server.
# ---------------------------------------------------------------------------

# Required. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — enables saving reports. https://api.imgbb.com/
# NOTE: uploaded images are PUBLIC; anyone with the URL can view them.
IMGBB_API_KEY=

# ---------------------------------------------------------------------------
# CLIENT-SIDE config. These ARE inlined into the bundle, which is correct:
# the Supabase URL is a public endpoint and the publishable key is designed to
# be public. Never put a service_role key here.
#
# Run supabase/001_reports.sql and 002_report_delete.sql before first use.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
